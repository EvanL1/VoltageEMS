# VoltageEMS Docker Environment Variables
# Copy this file to .env and customize for your environment:
#   cp .env.example .env

# ============================================
# REQUIRED - Must set before first deployment
# ============================================

# InfluxDB password (REQUIRED - no default for security)
# Generate a strong password: openssl rand -base64 32
INFLUXDB_PASSWORD=your-secure-password-here

# ============================================
# Path Configuration
# ============================================

# Base path for all VoltageEMS data (config, data, logs)
# Default: ./data (relative to docker-compose.yml)
# Production example: /opt/voltageems
VOLTAGE_BASE_PATH=./data

# ============================================
# User/Group IDs (for Linux file permissions)
# ============================================

# User ID and Group ID for container processes
# These MUST match your host user to avoid permission issues
#
# Auto-detection (recommended):
#   Run: id -u    # Get your UID
#   Run: id -g    # Get your GID
#
# Common defaults by OS:
#   macOS:  UID=501 (first user), GID=20 (staff group)
#   Linux:  UID=1000 (first user), GID=1000
HOST_UID=1000
HOST_GID=1000

# Dialout group for serial port access (Linux only)
# Get your system's dialout GID with: getent group dialout
DIALOUT_GID=20

# ============================================
# Service URLs (usually no need to change)
# ============================================

# Redis connection
VOLTAGE_REDIS_URL=redis://127.0.0.1:6379

# InfluxDB connection
INFLUXDB_URL=http://127.0.0.1:8181
INFLUXDB_ORG=voltage          # InfluxDB 2.x legacy; 3.x does not use org
INFLUXDB_BUCKET=history       # InfluxDB 2.x legacy; 3.x uses database name
# INFLUXDB_TOKEN=  # Set after initial InfluxDB setup

# Internal service URLs (for apigateway and monarch CLI)
VOLTAGE_COMSRV_URL=http://127.0.0.1:6001
VOLTAGE_MODSRV_URL=http://127.0.0.1:6002

# ============================================
# Path Configuration (for monarch CLI)
# ============================================

# Override auto-detected config and data paths
# These take precedence over auto-detection logic
# VOLTAGE_CONFIG_PATH=/opt/MonarchEdge/config
# VOLTAGE_DATA_PATH=/opt/MonarchEdge/data

# ============================================
# Logging
# ============================================

# Rust services log level (info, debug, trace)
# Supports filter syntax: info,comsrv=debug,modsrv=trace
RUST_LOG=info
